{
  "name": "mystery-road-awe-2026",
  "version": "1.0.0",
  "description": "Mystery Road Web Application",
  "main": "index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm typecheck && vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/main.js js/*.ts vite.config.js package.json tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "javascript",
    "modules",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
